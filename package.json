{
    "name": "dsh-reasoning-efforts",
    "version": "0.1.0",
    "description": "DeepSeek Harness 推理强度增强插件：自动为 llm-pi-ai 下所有自定义模型补齐 x-opencode reasoning effort 档位（off→max 全七档，默认 high），写入 settings 由 dsh 原生解析生效——新加的模型也会自动覆盖。",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "README.md",
        "README.zh.md",
        "LICENSE",
        "lib"
    ],
    "homepage": "https://github.com/Scorp1o117/dsh-reasoning-efforts",
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "reasoning",
        "reasoning-effort",
        "thinking"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Scorp1o117/dsh-reasoning-efforts.git"
    },
    "bugs": {
        "url": "https://github.com/Scorp1o117/dsh-reasoning-efforts/issues"
    },
    "scripts": {
        "test": "node tests/settings-scope-compat.test.mjs && node tests/ops.test.mjs"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-rc.1"
    }
}
