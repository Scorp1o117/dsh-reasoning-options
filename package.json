{
  "name": "dsh-reasoning-options",
  "version": "0.3.0",
  "description": "DeepSeek Harness 推理强度与网关增强插件：自动为 llm-pi-ai 下所有模型补齐推理强度档位（off→max 全七档），并自动为 OpenCode Go 网关注入必需的 x-opencode-session 路由 Header，写入 settings 由 dsh 原生解析生效。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1 <0.2.0",
      "dshReleases": {
        "0.1.5-rc.2": "incompatible",
        "0.1.5-rc.3": "incompatible",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "web"
      ]
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib"
  ],
  "homepage": "https://github.com/Scorp1o117/dsh-reasoning-options",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "reasoning-effort",
    "thinking"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-reasoning-options.git"
  },
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-reasoning-options/issues"
  },
  "scripts": {
    "test": "node tests/settings-scope-compat.test.mjs && node tests/ops.test.mjs && node --test tests/scheduling.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
