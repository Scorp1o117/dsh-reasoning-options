{
  "name": "dsh-reasoning-options",
  "version": "0.5.0",
  "description": "Reasoning levels and native Default (no injected effort) for DSH Web and Desktop.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.1.5-rc.2": "incompatible",
        "0.1.5-rc.3": "incompatible",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "incompatible",
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "locale",
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib",
    "client.js",
    "VERIFICATION.md"
  ],
  "homepage": "https://github.com/Scorp1o117/dsh-reasoning-options",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "reasoning-effort",
    "thinking"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-reasoning-options.git"
  },
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-reasoning-options/issues"
  },
  "scripts": {
    "test": "node tests/settings-scope-compat.test.mjs && node tests/ops.test.mjs && node --test tests/scheduling.test.mjs && node --test tests/plugin-page.test.mjs tests/client-write-flow.test.mjs && node --test tests/locale.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
